# ------------------------------------------------------------------ database --
# The schema is applied from apps/loader-api/supabase/ — loader.sql,
# loader-card-frame.sql and auth.sql, in that order. Nothing else to run.
#
# The service role key bypasses RLS, which is the point: RLS is on with no policy so
# that nothing else can reach these tables. Find it in the Supabase dashboard under
# Project Settings → API. It is server-only and must never be exposed to a browser,
# which is why it is pasted into the host's environment and not into a chat.
SUPABASE_URL=https://pqomyuqirfygoccsmbid.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------- admin login --
# One administrator. Set ADMIN_PASSWORD to something long; it is hashed in memory
# at boot and never stored.
ADMIN_USERNAME=snow
ADMIN_PASSWORD=
# 32+ random characters. Rotating it signs every panel session out.
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------- sign-in service --
# The product id the installer presents at /v1/login. It is not a secret — it is
# compiled into the Windows build — and it must match the value in
# apps/loader/src/main/services/auth.ts. Empty accepts any application id.
AUTH_APP_ID=7cceaf553a603ceb8d54a6c2

# -------------------------------------------------------------- object store --
# r2 | b2 | supabase | local. Empty picks the first one that has credentials.
STORAGE_DRIVER=

# Cloudflare R2 (egress is free; the right answer before the catalogue grows)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=snow-loader

# Backblaze B2 (S3-compatible)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

# Supabase Storage — the default, because the bucket already exists. 1 GB of
# storage and 50 MB per file on the free plan, so it holds artwork and film.
# Installers never go here: they live on GitHub Releases or a file host.
SUPABASE_BUCKET=loader-files

# Optional. When set, non-media files are served from this base instead of through
# the API. Media always uses the bucket's own public URL.
PUBLIC_BASE_URL=
